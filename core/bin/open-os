#!/usr/bin/env bash
# ==============================================================================
# Open OS - Master CLI Tool
# Command: open-os [run|install|proxy|frida|status|doctor|help]
# ==============================================================================

set -e

CONFIG_FILE="/etc/open-os/open-os.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="$(dirname "$(readlink -f "$0")")/../../config/open-os.conf"
fi

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

COLOR_RESET="\033[0m"
COLOR_CYAN="\033[1;36m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_RED="\033[1;31m"
COLOR_BOLD="\033[1m"

print_banner() {
    echo -e "${COLOR_CYAN}"
    echo "  ██████╗ ██████╗ ███████╗███╗   ██╗     ██████╗ ███████╗"
    echo " ██╔═══██╗██╔══██╗██╔════╝████╗  ██║    ██╔═══██╗██╔════╝"
    echo " ██║   ██║██████╔╝█████╗  ██╔██╗ ██║    ██║   ██║███████╗"
    echo " ██║   ██║██╔═══╝ ██╔══╝  ██║╚██╗██║    ██║   ██║╚════██║"
    echo " ╚██████╔╝██║     ███████╗██║ ╚████║    ╚██████╔╝███████║"
    echo "  ╚═════╝ ╚═╝     ╚══════╝╚═╝  ╚═══╝     ╚═════╝ ╚══════╝"
    echo -e "${COLOR_RESET}"
    echo -e "${COLOR_BOLD} Open OS: Universal Multi-Platform Cyber Security Workspace${COLOR_RESET}"
    echo -e " Running on Kali Linux Base | Architecture: $(uname -m)"
    echo " -------------------------------------------------------------"
}

usage() {
    print_banner
    echo -e "${COLOR_BOLD}Usage:${COLOR_RESET} open-os <command> [arguments]"
    echo ""
    echo -e "${COLOR_BOLD}Core Commands:${COLOR_RESET}"
    echo -e "  ${COLOR_GREEN}run <file>${COLOR_RESET}             Smart-execute any file (.apk, .exe, .AppImage, .deb, .sh)"
    echo -e "  ${COLOR_GREEN}install <file>${COLOR_RESET}         Install an app (.apk into Waydroid, .deb into system)"
    echo -e "  ${COLOR_GREEN}android [start|stop|shell|ui]${COLOR_RESET} Control the Waydroid Android Subsystem"
    echo ""
    echo -e "${COLOR_BOLD}Cyber Security & Mobile Pentest:${COLOR_RESET}"
    echo -e "  ${COLOR_GREEN}proxy [on|off|status]${COLOR_RESET}  Route Android traffic to Burp Suite / ZAP Proxy"
    echo -e "  ${COLOR_GREEN}frida [start|status]${COLOR_RESET}   Start or inspect Frida-server in Android container"
    echo -e "  ${COLOR_GREEN}analyze <file.apk>${COLOR_RESET}    Decompile and inspect APK with Jadx/Apktool"
    echo ""
    echo -e "${COLOR_BOLD}System Diagnostics:${COLOR_RESET}"
    echo -e "  ${COLOR_GREEN}status${COLOR_RESET}                 Check status of Android & Windows execution engines"
    echo -e "  ${COLOR_GREEN}doctor${COLOR_RESET}                 Verify kernel modules, dependencies, and setup"
    echo -e "  ${COLOR_GREEN}help${COLOR_RESET}                   Display this help message"
    echo ""
}

cmd_run() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${COLOR_RED}[!] Error:${COLOR_RESET} Please specify a file to run (e.g. open-os run app.apk)"
        exit 1
    fi

    if [ ! -f "$target" ]; then
        echo -e "${COLOR_RED}[!] Error:${COLOR_RESET} File not found: $target"
        exit 1
    fi

    local filename
    filename=$(basename "$target")
    local ext="${filename##*.}"
    ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    case "$ext" in
        apk)
            echo -e "${COLOR_CYAN}[*] Detected Android APK:${COLOR_RESET} $filename"
            open-os-apk-installer "$target"
            ;;
        exe|msi)
            echo -e "${COLOR_CYAN}[*] Detected Windows Binary:${COLOR_RESET} $filename"
            open-os-exe-launcher "$target"
            ;;
        appimage)
            echo -e "${COLOR_CYAN}[*] Detected Linux AppImage:${COLOR_RESET} $filename"
            chmod +x "$target"
            "$target" "$@"
            ;;
        deb)
            echo -e "${COLOR_CYAN}[*] Detected Debian Package:${COLOR_RESET} $filename"
            echo -e "${COLOR_YELLOW}[*] Installing via apt/dpkg...${COLOR_RESET}"
            sudo apt-get install -y "$target"
            ;;
        sh|py)
            echo -e "${COLOR_CYAN}[*] Detected Script:${COLOR_RESET} $filename"
            chmod +x "$target"
            if [ "$ext" = "py" ]; then
                python3 "$target"
            else
                bash "$target"
            fi
            ;;
        *)
            echo -e "${COLOR_YELLOW}[!] Unknown extension '.$ext'. Trying native execution...${COLOR_RESET}"
            if [ -x "$target" ]; then
                "$target"
            else
                xdg-open "$target" 2>/dev/null || echo -e "${COLOR_RED}[!] Could not execute $target${COLOR_RESET}"
            fi
            ;;
    esac
}

cmd_status() {
    print_banner
    echo -e "${COLOR_BOLD}[*] Open OS Engine Status:${COLOR_RESET}"
    echo ""
    
    # Waydroid Check
    echo -n "  • Android Subsystem (Waydroid): "
    if command -v waydroid >/dev/null 2>&1; then
        local w_status
        w_status=$(waydroid status 2>&1 || true)
        if echo "$w_status" | grep -q "RUNNING"; then
            echo -e "${COLOR_GREEN}RUNNING (Active)${COLOR_RESET}"
        elif echo "$w_status" | grep -q "STOPPED"; then
            echo -e "${COLOR_YELLOW}INSTALLED (Stopped)${COLOR_RESET}"
        else
            echo -e "${COLOR_YELLOW}INSTALLED (Not initialized)${COLOR_RESET}"
        fi
    else
        echo -e "${COLOR_RED}NOT INSTALLED${COLOR_RESET}"
    fi

    # Wine Check
    echo -n "  • Windows Engine (Wine-Staging): "
    if command -v wine >/dev/null 2>&1; then
        local wine_ver
        wine_ver=$(wine --version 2>/dev/null || echo "Present")
        echo -e "${COLOR_GREEN}AVAILABLE ($wine_ver)${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}NOT INSTALLED${COLOR_RESET}"
    fi

    # Display Server
    echo -n "  • Display Server: "
    if [ -n "$WAYLAND_DISPLAY" ]; then
        echo -e "${COLOR_GREEN}WAYLAND ($WAYLAND_DISPLAY)${COLOR_RESET}"
    elif [ -n "$DISPLAY" ]; then
        echo -e "${COLOR_YELLOW}X11 ($DISPLAY) - (Wayland recommended for Waydroid)${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}HEADLESS / NO GUI DISPLAY DETECTED${COLOR_RESET}"
    fi

    # Kernel Binder check
    echo -n "  • Android Binder IPC: "
    if ls -l /dev/binder* >/dev/null 2>&1; then
        echo -e "${COLOR_GREEN}READY (/dev/binder)${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}PENDING (Load via: sudo modprobe binder_linux)${COLOR_RESET}"
    fi

    echo ""
}

cmd_doctor() {
    print_banner
    echo -e "${COLOR_BOLD}[*] Running Open OS System Doctor...${COLOR_RESET}"
    echo ""
    local issues=0

    # Check CPU Virtualization
    echo -n "[1] Hardware Virtualization (VT-x/AMD-V): "
    if grep -E -q '(vmx|svm)' /proc/cpuinfo; then
        echo -e "${COLOR_GREEN}Supported${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}Warning: Nested virtualization might be disabled${COLOR_RESET}"
    fi

    # Check Binder
    echo -n "[2] Kernel Binder Modules: "
    if ls -l /dev/binder* >/dev/null 2>&1; then
        echo -e "${COLOR_GREEN}OK${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}Missing /dev/binder (Required for Android Subsystem)${COLOR_RESET}"
        issues=$((issues + 1))
    fi

    # Check Wayland
    echo -n "[3] Wayland Session: "
    if [ -n "$WAYLAND_DISPLAY" ]; then
        echo -e "${COLOR_GREEN}OK ($WAYLAND_DISPLAY)${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}Not running under Wayland. Launch via Sway or Weston.${COLOR_RESET}"
    fi

    # Check Pentest Tools
    echo -n "[4] Core Pentest Tooling (ADB, Jadx, Apktool, Burp): "
    local missing_tools=()
    for t in adb apktool jadx burpsuite msfconsole; do
        if ! command -v "$t" >/dev/null 2>&1; then
            missing_tools+=("$t")
        fi
    done
    if [ ${#missing_tools[@]} -eq 0 ]; then
        echo -e "${COLOR_GREEN}All Present${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}Missing: ${missing_tools[*]}${COLOR_RESET}"
    fi

    echo ""
    if [ $issues -eq 0 ]; then
        echo -e "${COLOR_GREEN}[✓] Open OS Core Subsystems are in good shape!${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}[!] $issues item(s) require attention.${COLOR_RESET}"
    fi
}

case "$1" in
    run)
        shift
        cmd_run "$@"
        ;;
    install)
        shift
        cmd_run "$@"
        ;;
    status)
        cmd_status
        ;;
    doctor)
        cmd_doctor
        ;;
    proxy)
        shift
        open-os-pentest-bridge proxy "$@"
        ;;
    frida)
        shift
        open-os-pentest-bridge frida "$@"
        ;;
    analyze)
        shift
        target="$1"
        if command -v jadx-gui >/dev/null 2>&1; then
            echo -e "${COLOR_GREEN}[*] Opening in JADX-GUI...${COLOR_RESET}"
            jadx-gui "$target" &
        elif command -v jadx >/dev/null 2>&1; then
            echo -e "${COLOR_GREEN}[*] Decompiling with JADX CLI...${COLOR_RESET}"
            jadx -d "${target}_decompiled" "$target"
            echo -e "${COLOR_GREEN}[✓] Output in: ${target}_decompiled${COLOR_RESET}"
        else
            echo -e "${COLOR_RED}[!] Jadx not installed. Please run: sudo apt-get install jadx${COLOR_RESET}"
        fi
        ;;
    android)
        shift
        subcmd="$1"
        case "$subcmd" in
            start)
                waydroid session start &
                ;;
            stop)
                waydroid session stop
                ;;
            ui)
                waydroid show-full-ui &
                ;;
            shell)
                waydroid shell
                ;;
            *)
                echo "Usage: open-os android [start|stop|ui|shell]"
                ;;
        esac
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        # If user directly gave a filename: open-os file.apk
        if [ -f "$1" ]; then
            cmd_run "$1"
        else
            echo -e "${COLOR_RED}[!] Unknown command:${COLOR_RESET} $1"
            usage
            exit 1
        fi
        ;;
esac
