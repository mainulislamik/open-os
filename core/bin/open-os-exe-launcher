#!/usr/bin/env bash
# ==============================================================================
# Open OS - Windows Binary Launcher
# Usage: open-os-exe-launcher <path_to_exe_or_msi>
# ==============================================================================

set -e

TARGET="$1"
if [ -z "$TARGET" ] || [ ! -f "$TARGET" ]; then
    echo "[!] Error: Please provide a valid .exe or .msi file."
    exit 1
fi

COLOR_CYAN="\033[1;36m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_RED="\033[1;31m"
COLOR_RESET="\033[0m"

echo -e "${COLOR_CYAN}[Open OS Windows Engine]${COLOR_RESET} Preparing to run: $(basename "$TARGET")"

if ! command -v wine >/dev/null 2>&1; then
    echo -e "${COLOR_RED}[!] Wine is not installed.${COLOR_RESET}"
    echo "    Run: sudo apt-get install -y wine wine64 winetricks"
    exit 1
fi

# Setup isolated or standard Wine prefix
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine-openos}"
export WINEDEBUG="-all" # Silence excessive debug chatter for clean UX

if [ ! -d "$WINEPREFIX" ]; then
    echo -e "${COLOR_YELLOW}[*] Initializing Open OS Wine Prefix ($WINEPREFIX)...${COLOR_RESET}"
    wineboot -i
fi

filename=$(basename "$TARGET")
ext="${filename##*.}"
ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

echo -e "${COLOR_GREEN}[*] Launching $filename with Wine...${COLOR_RESET}"
if [ "$ext" = "msi" ]; then
    wine msiexec /i "$TARGET" "$@"
else
    wine "$TARGET" "$@"
fi
